{
  "name": "sendit",
  "version": "0.1.0",
  "description": "Share files from the command line through a temporary public link",
  "type": "module",
  "bin": {
    "sendit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/cli.js",
    "bench": "tsx scripts/bench.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "dependencies": {
    "archiver": "8.0.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "26.1.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
